# Copy to .env and fill in. .env is gitignored: never commit real keys.

# --- LLM (pick one) ---------------------------------------------------------
# Option A, quickest: free Gemini API key from https://aistudio.google.com
GOOGLE_API_KEY=
INCIDENTPILOT_MODEL=google_genai:gemini-3.8-flash

# Option B: Vertex AI (needs `gcloud auth application-default login`)
# INCIDENTPILOT_MODEL=google_vertexai:gemini-3.8-flash
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_CLOUD_LOCATION=us-central1

# Option C: Claude (https://console.anthropic.com -> API keys)
# ANTHROPIC_API_KEY=
# INCIDENTPILOT_MODEL=anthropic:claude-opus-5-5

# --- Tracing (optional): see every agent step at https://smith.langchain.com --
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=incidentpilot

# --- Secrets for the demo shop (change for anything shared) -----------------
APPROVAL_SECRET=dev-approval-secret
SHOPDEMO_ADMIN_TOKEN=dev-admin-token
